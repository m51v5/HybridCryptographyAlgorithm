<Window x:Class="HybridCryptographyAlgorithm.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="About Hybrid Cryptography Algorithm" Icon="Assets/app.ico"
        Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#100E17" KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#9AA0A6"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4 18 0 6"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1B1824"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!-- One clickable row: label, optional value, chevron -->
        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="14 10" CornerRadius="8">
                            <DockPanel>
                                <materialDesign:PackIcon DockPanel.Dock="Right" Kind="ChevronRight" Width="16" Height="16"
                                                         Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8 0 0 0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2636"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2A2636" BorderThickness="1">
        <StackPanel MouseLeftButtonDown="Drag_Window" Background="Transparent">
            <!-- Gradient strip, same colors as the main window -->
            <Border Height="6">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFE68704" Offset="0"/>
                        <GradientStop Color="#FFE63070" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Button HorizontalAlignment="Right" Width="40" Height="32" ToolTip="Close" Click="Close_Button_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Margin="24 0 24 20">
                <!-- Identity -->
                <Image Source="Assets/app.png" Width="72" Height="72"/>
                <TextBlock Text="Hybrid Cryptography Algorithm" Foreground="White" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0 12 0 0"/>
                <TextBlock x:Name="versionText" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0 2 0 0"/>
                <TextBlock Text="Encrypt text files with AES and DES, alternating per block." Foreground="White"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0 12 0 0"/>

                <TextBlock Text="PROJECT" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button Style="{StaticResource Row}" Click="Link_Click" x:Name="rowReleases">
                            <TextBlock Text="What's new"/>
                        </Button>
                        <Button Style="{StaticResource Row}" Click="Update_Click" x:Name="rowUpdate" ToolTip="Asks GitHub for the latest release">
                            <DockPanel>
                                <TextBlock x:Name="updateText" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="Check for updates"/>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource Row}" Click="Link_Click" x:Name="rowSource">
                            <TextBlock Text="Source code"/>
                        </Button>
                        <Button Style="{StaticResource Row}" Click="Link_Click" x:Name="rowSecurity">
                            <TextBlock Text="Security and limits"/>
                        </Button>
                        <Button Style="{StaticResource Row}" Click="Link_Click" x:Name="rowLicense">
                            <DockPanel>
                                <TextBlock Text="MIT" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="License"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Text="HELP" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <Button Style="{StaticResource Row}" Click="Link_Click" x:Name="rowReport">
                        <TextBlock Text="Report a problem"/>
                    </Button>
                </Border>

                <TextBlock Text="MADE BY" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button Style="{StaticResource Row}" Click="Link_Click" x:Name="rowWebsite">
                            <DockPanel>
                                <TextBlock Text="@m51v5" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="Mustafa Jassem"/>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource Row}" Click="Link_Click" x:Name="rowTelegram">
                            <DockPanel>
                                <TextBlock Text="@m51v5" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="Telegram"/>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource Row}" Click="Link_Click" x:Name="rowContact">
                            <TextBlock Text="Other platforms"/>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2025 @m51v5. MIT License." Foreground="{StaticResource Muted}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0 20 0 0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
