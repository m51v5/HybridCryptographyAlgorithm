<Window x:Class="HybridCryptographyAlgorithm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:HybridCryptographyAlgorithm"
        mc:Ignorable="d"
        Title="Hybrid Cryptography Algorithm" Icon="Assets/app.ico" Height="450" Width="800" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Window.Resources>
        <!-- Small white icon button for the window corner -->
        <Style x:Key="CornerButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CornerButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid MouseLeftButtonDown="Drag_Window">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#FFE68704" Offset="0"/>
                <GradientStop Color="#FFE63070" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Height="390" VerticalAlignment="Top" CornerRadius="0 0 180 0" 
                Background="#100E17" MouseLeftButtonDown="Drag_Window"/>

        <StackPanel Orientation="Horizontal">

            <!-- Encrypt Form -->
            <StackPanel Width="350">
                <StackPanel Margin="20 40">

                    <TextBlock Text="Encrypt Form" Margin="20" Foreground="White" 
                               TextAlignment="Center" FontSize="22" FontFamily="Colonna MT"/>

                    <!-- File Upload -->
                    <StackPanel Orientation="Horizontal" Margin="20 10">
                        <materialDesign:PackIcon Kind="FileCode" Foreground="White" Width="25" Height="25"/>

                        <TextBox x:Name="txtFilePathForEncrypt" materialDesign:HintAssist.Hint="Double click to upload .txt File"
                                Width="230" AcceptsReturn="true" TextWrapping="WrapWithOverflow"
                                Margin="10 0" Foreground="White" Background="Black"
                                BorderBrush="White" CaretBrush="#FFD94448" 
                                SelectionBrush="#FFD94448" IsReadOnly="True"
                                MouseDoubleClick="PickTextFileOnDoubleClick"/>
                    </StackPanel>

                    <!-- Encrypt Button -->
                    <StackPanel HorizontalAlignment="center" Margin="20 10">
                        <Button x:Name="btnEncrypt" Content="Encrypt"
                                Width="100" Height="40" Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="10" BorderThickness="2" BorderBrush="#D94448"
                                Background="#D94448" Foreground="White" ToolTip="Action" Click="Encrypt_Button_Click"
                                 />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Decrypt Form -->
            <StackPanel Width="350">
                <StackPanel Margin="20 40">

                    <TextBlock Text="Decrypt Form" Margin="20" Foreground="White" 
                               TextAlignment="Center" FontSize="22" FontFamily="Colonna MT"/>
                    
                    <!-- Hybrid Key -->
                    <StackPanel Orientation="Horizontal" Margin="20 10">
                        <materialDesign:PackIcon Kind="Key" Foreground="White" Width="25" Height="25"/>

                        <TextBox x:Name="txtHybridKeyForDecrypt" materialDesign:HintAssist.Hint="Enter Hybrid Key"
                                 Width="230" Margin="10 0" Foreground="White" Background="Black" 
                                 BorderBrush="White"
                                 SelectionBrush="#FFD94448" CaretBrush="#FFD94448"
                                 />
                    </StackPanel>

                    <!-- File Upload -->
                    <StackPanel Orientation="Horizontal" Margin="20 10">
                        <materialDesign:PackIcon Kind="FileCode" Foreground="White" Width="25" Height="25"/>
                        
                        <TextBox x:Name="txtFilePathForDecrypt" materialDesign:HintAssist.Hint="Double click to upload .txt File"
                                 Width="230" AcceptsReturn="true" TextWrapping="WrapWithOverflow"
                                 Margin="10 0" Foreground="White" Background="Black"
                                 BorderBrush="White" CaretBrush="#FFD94448" 
                                 SelectionBrush="#FFD94448" IsReadOnly="True"
                                 MouseDoubleClick="PickTextFileOnDoubleClick"/>
                    </StackPanel>

                    <!-- Decrypt Button -->
                    <StackPanel HorizontalAlignment="center" Margin="20 10">
                        <Button x:Name="btnDecrypt" Content="Decrypt"
                                Width="100" Height="40" Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="10" BorderThickness="2" BorderBrush="#D94448"
                                Background="#D94448" Foreground="White" ToolTip="Action" Click="Decrypt_Button_Click"
                                 />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

        </StackPanel>

        <!-- About, minimize and close -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="btnAbout" Style="{StaticResource CornerButton}" ToolTip="About" Click="About_Button_Click">
                <Grid>
                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"/>
                    <Ellipse x:Name="updateDot" Width="8" Height="8" Fill="#FFE68704"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -2 -4 0" Visibility="Collapsed"/>
                </Grid>
            </Button>
            <Button Style="{StaticResource CornerButton}" ToolTip="Minimize" Click="Minimize_Button_Click">
                <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18"/>
            </Button>
            <Button Style="{StaticResource CloseButton}" ToolTip="Close" Click="Close_Button_Click">
                <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
